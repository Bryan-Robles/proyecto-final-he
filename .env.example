# Copiar a .env y rellenar con valores LOCALES. Nunca subir .env al repo.
# Valores de EJEMPLO — no son secretos reales.

NODE_ENV=development

# Puertos
PORT=4000

# MongoDB (instancia local del laboratorio)
MONGODB_URI=mongodb://localhost:27017/nodegoat

# Secreto de sesión (generar uno local, NO reutilizar en ningún otro sitio)
SESSION_SECRET=cambia-esto-por-un-valor-local
COOKIE_SECRET=cambia-esto-por-un-valor-local
